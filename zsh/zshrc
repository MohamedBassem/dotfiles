source "$DOTFILES_ROOT/shell/environment.sh"
source "$DOTFILES_ROOT/zsh/init-before.zsh"
if [[ -r "$HOME/.local/share/prezto/init.zsh" ]]; then
  source "$HOME/.local/share/prezto/init.zsh"
fi
source "$DOTFILES_ROOT/shell/environment.sh"
source "$DOTFILES_ROOT/shell/interactive.sh"
command -v mise >/dev/null && eval "$(mise activate zsh)"
command -v fzf >/dev/null && source <(fzf --zsh)
command -v direnv >/dev/null && eval "$(direnv hook zsh)"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v atuin >/dev/null && eval "$(atuin init zsh --disable-up-arrow)"
source "$DOTFILES_ROOT/zsh/init-after.zsh"
