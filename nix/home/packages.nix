      httpie
      iperf3
      jq
      jujutsu
      just
      lazygit
      libargon2
      monolith
      mosh
      neovim
      nixpacks
      opencode
      pipx
      rclone
      ripgrep
      rsync
      rtk
      serpl
      shellcheck
      sops
      stow
      stripe-cli
      stylua
      tmux
      tree
      tree-sitter
      viu
      watch
      wget
      wrk
      yq
      yt-dlp
      zizmor
      zoxide
