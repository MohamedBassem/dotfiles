[ui]
username = MohamedBassem <me@mbassem.com>

[alias]
d = diff
s = show
main = goto remote/main
submit-stack = !sl-submit-stack "$@"
worktrees = !sl-share-worktree "$@"
ls = log -r 'reverse(::.)' -T '{label("green", node|short)} {label("yellow", "[{date|age}]")}{if(bookmarks, label("red", " ({join(bookmarks, ", ")})"))}{if(remotenames, label("red", " ({join(remotenames, ", ")})"))} {desc|firstline}{label("blue", " [{author|person}]")}\n'
sp = !sp "$@"

[pager]
pager = hunk pager

[fsmonitor]
mode = on

[hint]
ack = smartlog-default-command

[github]
# Give each commit its own PR diff by basing it on the preceding commit's PR
# branch. This is also the branch topology expected by GitHub Stacked PRs.
pr-workflow = single

# GitHub's native stack UI replaces the ReviewStack link Sapling otherwise
# adds to every pull request body.
pull-request-include-reviewstack = false
